APP_NAME=CommercePilot
APP_ENV=development
DATABASE_URL=postgresql+psycopg://commerce:commerce@localhost:5432/commerce_pilot
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
RAG_PROVIDER=deterministic
# 店铺数据来源：mock（本地合成数据）| taobao（离线 TOP 请求映射骨架）
PLATFORM_PROVIDER=mock
# TOP 字段仅用于注入 fake transport 的协议映射测试；本项目不会用它们发起真实网络请求
TAOBAO_GATEWAY_URL=https://eco.taobao.com/router/rest
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_RERANK_MODEL=qwen3-rerank
LLM_PROVIDER=deterministic
DASHSCOPE_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_SUPERVISOR_MODEL=qwen3.7-flash
DASHSCOPE_STRATEGY_MODEL=qwen3.7-plus
LLM_MAX_OUTPUT_TOKENS=800
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_SECONDS=0.25
JWT_SECRET_KEY=commerce-pilot-dev-only-secret-change-before-production
JWT_ALGORITHM=HS256
JWT_ISSUER=commerce-pilot
JWT_AUDIENCE=commerce-pilot-api
JWT_ACCESS_TOKEN_MINUTES=60
OTEL_ENABLED=false
OTEL_SERVICE_NAME=commerce-pilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_CONSOLE_EXPORTER=false
